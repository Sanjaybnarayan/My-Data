{
  "name": "my-data",
  "version": "1.0.0",
  "private": true,
  "description": "FamilyOS — an offline-first record keeper for a household, encrypted on the device.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tests/run.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "node tools/bundle.mjs",
    "statement": "node tools/statement.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "build:web": "node tools/webroot.mjs",
    "cap:sync": "npm run build:web && cap sync",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:ios": "npm run cap:sync && cap run ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:doctor": "cap doctor",
    "capacitor:copy:before": "node tools/webroot.mjs"
  },
  "//": "The application itself has no dependencies and no build step. Playwright is here only because the browser checks need a browser to drive.",
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1"
  }
}
